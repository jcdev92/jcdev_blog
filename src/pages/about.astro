---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Sobre Mí";
const pageDescription = "Conoce más sobre el desarrollador detrás del blog.";

const identity = {
  firstName: "Jesus",
  country: "Venezuela",
  occupation: "Desarrollador Web",
  hobbies: ["Cine", "Programación", "Fútbol", "Beisbol"],
};

const skills = [
  "HTML",
  "CSS",
  "JavaScript",
  "TypeScript",
  "React",
  "Astro",
  "Tailwind CSS",
  "Shadcn UI",
  "Next JS",
  "Nest JS",
  "Node JS",
  "TypeORM",
  "PostgreSQL",
  "Git",
  "GitHub",
  "GitLab",
  "Docker",
  "Linux",
  "N8N",
];
---

<BaseLayout pageTitle={pageTitle} pageDescription={pageDescription}>
  <section class="max-w-3xl mx-auto px-4 py-12 md:py-20">
    <div class="text-center mb-16 space-y-4">
      <h1
        class="text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-white font-sans"
      >
        Hola, soy <span
          class="text-transparent bg-clip-text bg-linear-to-r from-blue-500 to-teal-400"
          >{identity.firstName}</span
        >
      </h1>
      <p
        class="text-xl text-slate-600 dark:text-slate-300 font-serif italic max-w-2xl mx-auto"
      >
        {identity.occupation} viviendo en {identity.country}.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-12 items-start">
      <div class="space-y-6">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white font-sans">
          Mi Historia
        </h2>
        <div
          class="prose prose-slate dark:prose-invert font-serif text-slate-600 dark:text-slate-300 leading-relaxed"
        >
          <p>
            ¡Bienvenido a mi rincón en la web! Actualmente estoy enfocado en
            crear experiencias web modernas y accesibles. Este blog es parte de
            mi viaje aprendiendo y dominando Astro, un framework que me ha
            sorprendido por su rendimiento y simplicidad.
          </p>
          <p>
            Cuando no estoy escribiendo código, probablemente me encontrarás
            disfrutando de mis hobbies como ver una buena película de {
              identity.hobbies[0].toLowerCase()
            } o viendo un partido de {identity.hobbies[2].toLowerCase()}.
          </p>
        </div>
      </div>

      <div class="space-y-8">
        <div>
          <h2
            class="text-2xl font-bold text-slate-900 dark:text-white font-sans mb-4"
          >
            Habilidades Técnicas
          </h2>
          <div class="flex flex-wrap gap-2">
            {
              skills.map((skill) => (
                <span class="px-3 py-1 text-sm font-medium text-slate-700 bg-slate-100 rounded-md dark:bg-slate-800 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                  {skill}
                </span>
              ))
            }
          </div>
        </div>

        <div>
          <h2
            class="text-2xl font-bold text-slate-900 dark:text-white font-sans mb-4"
          >
            Intereses
          </h2>
          <ul class="space-y-2">
            {
              identity.hobbies.map((hobby) => (
                <li class="flex items-center text-slate-600 dark:text-slate-300 font-serif">
                  <svg
                    class="w-4 h-4 mr-2 text-teal-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  {hobby}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
