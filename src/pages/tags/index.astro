---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
type BlogPostEntry = CollectionEntry<"blog">;
const pageTitle = "Tags";
const tags = (await getCollection("blog")).flatMap(
  (post: BlogPostEntry) => post.data.tags,
);
const uniqueTags = [...new Set(tags)];
---

<BaseLayout pageTitle={pageTitle}>
  <ul class="flex flex-wrap list-none p-0">
    {
      uniqueTags.map((tag: string) => (
        <li class="m-1 border border-dotted border-gray-400 rounded-lg px-4 py-2 text-lg bg-slate-50 dark:bg-slate-800">
          <a
            href={`/tags/${tag}`}
            class="text-[#00539f] no-underline dark:text-[#ff9776]"
          >
            {tag}
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
