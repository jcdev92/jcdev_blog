---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Greetings from "@/components/Greetings.jsx";
const pageTitle = "Home";
const pageDescription = "Home";
const messages = [
  "¡Hola!",
  "Como ta la vaina?",
  "Que onda",
  "Hablame, qeloq dice",
  "Ja weno, bienvenido pue!",
];
const owner = "Jesus Clemente";
const siteTitle = "Blog del GZUS";
---

<BaseLayout pageTitle={pageTitle} pageDescription={pageDescription}>
  <body class="flex flex-col gap-4">
    <header class="flex flex-col gap-2">
      <p class="text-2xl font-bold">
        Bienvenidos al <span class="font-sans text-orange-300 text-shadow-sm/30"
          >{siteTitle}</span
        >
      </p>
      <p>Aqui aprenderemos a crear blogs con astro.</p>
      <Greetings client:load messages={messages} />
      <footer class="flex justify-center">
        <p>© {new Date().getFullYear()} {owner}</p>
      </footer>
    </header>
  </body>
</BaseLayout>
