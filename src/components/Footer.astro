---
import Social from "./Social.astro";
---

<footer
  class="border-t border-gray-100 dark:border-gray-800 bg-gray-50 dark:bg-[#0a0a0a] mt-20"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div
      class="flex flex-col md:flex-row items-center justify-between gap-6 text-sm text-gray-500 font-sans"
    >
      <div class="flex gap-6">
        <Social platform="github" username="jcdev92" />
        <Social platform="x" username="jcdev92" />
      </div>
      <p>
        © {new Date().getFullYear()} El Blog del GZUS. Creado con Astro y Keystatic.
      </p>
    </div>
  </div>
</footer>
