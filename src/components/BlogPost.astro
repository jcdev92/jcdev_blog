---
import { Image } from "astro:assets";

const { post } = Astro.props;
---

<article
  class="flex flex-col md:flex-row gap-6 items-start border-b border-gray-100 dark:border-gray-800 py-10 last:border-b-0 group text-left"
>
  <div class="flex-1 flex flex-col gap-3">
    <div
      class="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400 font-sans font-medium uppercase tracking-wide"
    >
      <span>{post.data.author}</span>
      <span>·</span>
      <time datetime={post.data.pubDate.toISOString()}
        >{post.data.pubDate.toString().slice(0, 10)}</time
      >
    </div>

    <a href={`/posts/${post.id}/`} class="no-underline">
      <h2
        class="text-2xl font-bold text-gray-900 dark:text-gray-100 group-hover:text-gray-700 dark:group-hover:text-white leading-tight mb-2 font-sans"
      >
        {post.data.title}
      </h2>
      <p
        class="text-gray-600 dark:text-gray-300 font-serif leading-relaxed line-clamp-3 text-base"
      >
        {post.data.description}
      </p>
    </a>
  </div>

  {
    post.data.image.url && (
      <a
        href={`/posts/${post.id}/`}
        class="w-full md:w-40 md:h-28 shrink-0 overflow-hidden rounded-md block"
      >
        <Image
          src={post.data.image.url}
          alt={post.data.image.alt}
          inferSize
          width={300}
          class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      </a>
    )
  }
</article>
