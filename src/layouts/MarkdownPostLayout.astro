---
import BaseLayout from "./BaseLayout.astro";
import { Image } from "astro:assets";

const { frontmatter } = Astro.props;
const tags = frontmatter.tags;
---

<BaseLayout
  pageTitle={frontmatter.title}
  pageDescription={frontmatter.description}
>
  <article
    class="w-full max-w-4xl mx-auto px-4 py-8 overflow-hidden break-words"
  >
    <header class="text-center mb-12">
      <div
        class="flex items-center justify-center gap-2 text-sm text-gray-500 dark:text-gray-400 font-sans mb-6 uppercase tracking-wider"
      >
        <span>{frontmatter.pubDate.toString().slice(0, 10)}</span>
        <span class="w-1 h-1 bg-gray-300 dark:bg-gray-600 rounded-full"></span>
        <span>{frontmatter.author}</span>
      </div>
      <h1
        class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-gray-100 leading-tight mb-6 font-sans text-center"
      >
        {frontmatter.title}
      </h1>
      <p
        class="text-xl text-gray-500 dark:text-gray-400 font-serif italic max-w-2xl mx-auto"
      >
        {frontmatter.description}
      </p>
    </header>

    {
      frontmatter.image.url && (
        <div class="w-full mb-12">
          <Image
            src={frontmatter.image.url}
            width={1000}
            inferSize
            alt={frontmatter.image.alt}
            class="w-full h-auto rounded-lg shadow-sm"
          />
        </div>
      )
    }

    <div
      class="prose prose-lg prose-slate dark:prose-invert mx-auto font-serif prose-headings:font-sans prose-headings:font-bold prose-p:text-gray-800 dark:prose-p:text-gray-200 prose-a:text-green-700 dark:prose-a:text-green-400 hover:prose-a:text-green-800 dark:hover:prose-a:text-green-300 text-justify"
    >
      <slot />
    </div>
  </article>

  <div>
    <ul class="flex flex-wrap list-none p-0 gap-2">
      {
        tags.map((tag: any) => (
          <li>
            <a
              href={`/tags/${tag}`}
              class="inline-block px-3 py-1 text-sm font-medium text-gray-600 bg-gray-100 rounded-full hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700 transition-colors no-underline"
            >
              {tag}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
