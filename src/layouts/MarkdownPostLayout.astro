---
import BaseLayout from "./BaseLayout.astro";
import { Image } from "astro:assets";

const { frontmatter } = Astro.props;
const tags = frontmatter.tags;
---

<BaseLayout
  pageTitle={frontmatter.title}
  pageDescription={frontmatter.description}
>
  <body>
    <p>{frontmatter.pubDate.toString().slice(0, 10)}</p>
    <p><em>{frontmatter.description}</em></p>
    <p>Escrito por: {frontmatter.author}</p>
    <Image
      src={frontmatter.image.url}
      width={300}
      inferSize
      alt={frontmatter.image.alt}
      class="max-w-full h-auto rounded-lg"
    />
    <slot />
  </body>

  <div>
    <ul class="flex flex-wrap list-none p-0">
      {
        tags.map((tag: any) => (
          <li class="m-1 border border-dotted border-gray-400 rounded-lg px-4 py-2 text-lg bg-slate-50 dark:bg-slate-800">
            <a
              href={`/tags/${tag}`}
              class="text-[#00539f] no-underline dark:text-[#ff9776]"
            >
              {tag}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
